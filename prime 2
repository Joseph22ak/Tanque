<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PRIME 2026 | Sports Platform</title>
  <link rel="Stylesheet" href="Prime.css">

   
</head>
<body>

  <!-- NAVBAR -->
  <nav>
    <div class="nav-inner">
      <a class="logo" href="#" onclick="go('home')">PRIME <span>2026</span></a>
      <ul class="nav-links">
        <li><a href="#" onclick="go('home')">Inicio</a></li>
        <li><a href="#" onclick="go('courts')">Courts</a></li>
        <li><a href="#" onclick="go('community')">Community</a></li>
        <li><a href="#" onclick="go('blog')">Blog</a></li>
        <li><a href="#" onclick="go('contact')">Contact</a></li>
      </ul>
      <a class="nav-cta" href="#" onclick="go('contact')">Sign In</a>
      <button class="menu-toggle" onclick="toggleMenu()" aria-label="Menu">☰</button>
    </div>
    <div class="mobile-menu" id="mobileMenu">
      <a href="#" onclick="go('home')">Inicio</a>
      <a href="#" onclick="go('courts')">Courts</a>
      <a href="#" onclick="go('community')">Community</a>
      <a href="#" onclick="go('blog')">Blog</a>
      <a href="#" onclick="go('contact')">Contact</a>
    </div>
  </nav>

  <!-- ===== HOME ===== -->
  <div class="page active" id="home">
    <section class="hero">
      <div class="hero-bg">
        <img src="https://images.unsplash.com/photo-1461896836934-ffe607ba8211?auto=format&fit=crop&q=80&w=2070" alt="">
      </div>
      <div class="hero-content">
        <p class="uppercase-track text-accent">Sports Platform</p>
        <h1>Connect, Train<br>And Play,<br><span class="text-accent">With Prime.</span></h1>
        <p class="sub"<Find courts, connect with certified coaches, and organize matches with a sports community—all in one place.</p>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#" onclick="go('courts')">Explore→</a>
          <a class="btn btn-outline" href="#" onclick="go('community')">Join the Community</a>
        </div>
      </div>
    </section>

    <section class="stats">
      <div class="stat">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <div><div class="stat-num">+30</div><div class="stat-label">Courts Available</div></div>
      </div>
      <div class="stat">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M15.5 13.5L17 22l-5-3-5 3 1.5-8.5"/></svg>
        <div><div class="stat-num">+50</div><div class="stat-label">Certified Coaches</div></div>
      </div>
      <div class="stat">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <div><div class="stat-num">+500</div><div class="stat-label">Active Users</div></div>
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <p class="uppercase-track text-accent">What We Offer</p>
        <h2>Everything you need for your game, all in one platform.</h2>
      </div>
      <div class="grid-3">
        <div class="card">
          <div class="card-img"><img src="https://images.unsplash.com/photo-1546519638-68e109498ffc?auto=format&fit=crop&q=80&w=1200" alt=""></div>
          <div class="card-body"><span class="card-num">01</span><h3>Book Courts</h3><p>Find and book available courts near you in real time, hassle-free.</p></div>
        </div>
        <div class="card">
          <div class="card-img"><img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?auto=format&fit=crop&q=80&w=1200" alt=""></div>
          <div class="card-body"><span class="card-num">02</span><h3>Certified Coaches</h3><p>Conecta con coaches profesionales que se ajustan a tu nivel, deporte y horario.</p></div>
        </div>
        <div class="card">
          <div class="card-img"><img src="https://images.unsplash.com/photo-1517649763962-0c623066013b?auto=format&fit=crop&q=80&w=1200" alt=""></div>
          <div class="card-body"><span class="card-num">03</span><h3>Organiza Partidos</h3><p>Arma partidos con jugadores de tu nivel y únete a la comunidad deportiva activa.</p></div>
        </div>
      </div>
    </section>

    <section class="cta-band">
      <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#00E5FF" stroke-width="2" style="margin:0 auto;"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
      <h2>¿Listo para empezar a jugar?</h2>
      <p class="muted">Únete a la comunidad deportiva más activa de la ciudad.</p>
      <a class="btn btn-primary" href="#" onclick="go('contact')" style="margin-top:32px;">Contáctanos →</a>
    </section>
  </div>

  <!-- ===== COURTS ===== -->
  <div class="page" id="courts">
    <div class="page-head">
      <p class="uppercase-track text-accent">Reserva tu espacio</p>
      <h1>Courts disponibles</h1>
      <p>Explora las canchas disponibles y reserva tu próxima partida.</p>
    </div>
    <section class="section">
      <div class="filters" id="filters">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00E5FF" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
        <button class="active" onclick="filterCourts('Todos', this)">Todos</button>
        <button onclick="filterCourts('Fútbol', this)">Fútbol</button>
        <button onclick="filterCourts('Tenis', this)">Tenis</button>
        <button onclick="filterCourts('Básquet', this)">Básquet</button>
        <button onclick="filterCourts('Pádel', this)">Pádel</button>
        <button onclick="filterCourts('Vólibol', this)">Vólibol</button>
      </div>
      <div class="grid-3" id="courtsGrid"></div>
    </section>
  </div>

  <!-- ===== COMMUNITY ===== -->
  <div class="page" id="community">
    <div class="page-head">
      <p class="uppercase-track text-accent">Únete al juego</p>
      <h1>La comunidad Prime</h1>
      <p>Conecta con jugadores, organízate y participa en eventos deportivos.</p>
    </div>
    <section class="section">
      <div class="grid-3" style="grid-template-columns:repeat(4,1fr);margin-bottom:80px;" id="playersGrid"></div>
      <div class="section-head" style="margin-bottom:48px;">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#00E5FF" stroke-width="2"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/><path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
        <h2 style="margin-top:16px;">Próximos eventos</h2>
      </div>
      <div style="display:flex;flex-direction:column;gap:1px;" id="eventsList"></div>
    </section>
  </div>

  <!-- ===== BLOG ===== -->
  <div class="page" id="blog">
    <div class="page-head">
      <p class="uppercase-track text-accent">Ideas y entrenamiento</p>
      <h1>El Blog de Prime</h1>
      <p>Consejos, guías y novedades del mundo deportivo.</p>
    </div>
    <section class="section">
      <div class="grid-2" id="blogGrid"></div>
    </section>
  </div>

  <!-- ===== CONTACT ===== -->
  <div class="page" id="contact">
    <div class="page-head">
      <p class="uppercase-track text-accent">Hablemos</p>
      <h1>Contáctanos</h1>
      <p>¿Tienes preguntas o quieres unirte a Prime? Escríbenos.</p>
    </div>
    <section class="section">
      <div class="contact-grid">
        <div>
          <h2 style="font-size:1.5rem;margin-bottom:32px;">Información</h2>
          <ul class="info-list">
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg><div><div class="info-label">Ubicación</div><p>Ciudad de Panamá, Panamá</p></div></li>
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg><div><div class="info-label">Email</div><p>info@prime2026.com</p></div></li>
            <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg><div><div class="info-label">Teléfono</div><p>+507 000-0000</p></div></li>
          </ul>
        </div>
        <div id="contactFormWrap">
          <form class="form" id="contactForm" onsubmit="submitForm(event)">
            <div class="form-row">
              <div><label>Nombre</label><input required></div>
              <div><label>Email</label><input type="email" required></div>
            </div>
            <div><label>Asunto</label><input></div>
            <div><label>Mensaje</label><textarea rows="5" required></textarea></div>
            <button class="btn btn-primary" type="submit">Enviar mensaje ➤</button>
          </form>
        </div>
      </div>
    </section>
  </div>

  <!-- FOOTER -->
  <footer>
    <div class="footer-grid">
      <div class="footer-brand">
        <div class="logo">PRIME <span>2026</span></div>
        <p>Conecta, entrena y juega con la comunidad deportiva más activa. Canchas, entrenadores certificados y partidos organizados en un solo lugar.</p>
        <div class="footer-social">
          <a href="#" aria-label="Instagram"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg></a>
          <a href="#" aria-label="Facebook"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg></a>
          <a href="#" aria-label="Twitter"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"/></svg></a>
        </div>
      </div>
      <div class="footer-col">
        <h4>Navegación</h4>
        <a href="#" onclick="go('home')">Inicio</a>
        <a href="#" onclick="go('courts')">Courts</a>
        <a href="#" onclick="go('community')">Community</a>
        <a href="#" onclick="go('blog')">Blog</a>
        <a href="#" onclick="go('contact')">Contact</a>
      </div>
      <div class="footer-col">
        <h4>Contacto</h4>
        <p><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#00E5FF" stroke-width="2" style="flex-shrink:0;"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg> Ciudad de Panamá, PA</p>
        <p>info@prime2026.com</p>
        <p>+507 000-0000</p>
      </div>
    </div>
    <div class="footer-bottom">
      <p>© 2026 PRIME. Todos los derechos reservados.</p>
      <p>Sports Platform</p>
    </div>
  </footer>

  <script>
    // Navigation
    function go(page) {
      event.preventDefault();
      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      document.getElementById(page).classList.add('active');
      window.scrollTo(0, 0);
      document.getElementById('mobileMenu').classList.remove('open');
    }
    function toggleMenu() {
      document.getElementById('mobileMenu').classList.toggle('open');
    }

    // Courts data
    var courts = [
      { name: 'Cancha El Cangrejo', sport: 'Fútbol', location: 'San Francisco', price: '$25/hora', img: 'https://images.unsplash.com/photo-1551958219-acbc608c6377?auto=format&fit=crop&q=80&w=1200' },
      { name: 'Prime Tennis Club', sport: 'Tenis', location: 'Clayton', price: '$18/hora', img: 'https://images.unsplash.com/photo-1622279457486-62dcc4a431d6?auto=format&fit=crop&q=80&w=1200' },
      { name: 'Basket Arena', sport: 'Básquet', location: 'Obarrio', price: '$20/hora', img: 'https://images.unsplash.com/photo-1546519638-68e109498ffc?auto=format&fit=crop&q=80&w=1200' },
      { name: 'Pádel Zone', sport: 'Pádel', location: 'Costa del Este', price: '$30/hora', img: 'https://images.unsplash.com/photo-1606107837371-4bc24e703649?auto=format&fit=crop&q=80&w=1200' },
      { name: 'Beach Volley Court', sport: 'Vólibol', location: 'Punta Pacífica', price: '$22/hora', img: 'https://images.unsplash.com/photo-1583136529515-0e4bc0c4c5b3?auto=format&fit=crop&q=80&w=1200' },
      { name: 'Green Field 2', sport: 'Fútbol', location: 'Bethania', price: '$25/hora', img: 'https://images.unsplash.com/photo-1579952363873-27f5b4cf2153?auto=format&fit=crop&q=80&w=1200' }
    ];
    function renderCourts(list) {
      document.getElementById('courtsGrid').innerHTML = list.map(function(c) {
        return '<div class="card court-card"><div class="card-img"><img src="'+c.img+'" alt="'+c.name+'"></div><div class="card-body"><div class="court-top"><h3>'+c.name+'</h3><span class="court-price">'+c.price+'</span></div><div class="court-meta"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>'+c.sport+'</div><div class="court-meta"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>'+c.location+'</div><button class="court-btn">Reservar</button></div></div>';
      }).join('');
    }
    function filterCourts(sport, btn) {
      document.querySelectorAll('#filters button').forEach(function(b){ b.classList.remove('active'); });
      btn.classList.add('active');
      renderCourts(sport === 'Todos' ? courts : courts.filter(function(c){ return c.sport === sport; }));
    }
    renderCourts(courts);

    // Players
    var players = [
      { name: 'Carlos Mendoza', sport: 'Fútbol', level: 'Avanzado', img: 'https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?auto=format&fit=crop&q=80&w=600' },
      { name: 'Ana Ruiz', sport: 'Tenis', level: 'Intermedio', img: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&q=80&w=600' },
      { name: 'Diego Torres', sport: 'Básquet', level: 'Profesional', img: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&q=80&w=600' },
      { name: 'María López', sport: 'Pádel', level: 'Principiante', img: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?auto=format&fit=crop&q=80&w=600' }
    ];
    document.getElementById('playersGrid').innerHTML = players.map(function(p) {
      return '<div class="card player-card"><div class="card-img"><img src="'+p.img+'" alt="'+p.name+'"></div><div class="card-body"><h3>'+p.name+'</h3><p class="meta">'+p.sport+' · '+p.level+'</p><button class="connect">💬 Conectar</button></div></div>';
    }).join('');

    // Events
    var events = [
      { title: 'Torneo Prime Fútbol', date: '15 Oct 2026', spots: '24 jugadores' },
      { title: 'Clínica de Tenis', date: '22 Oct 2026', spots: '12 jugadores' },
      { title: 'Liga de Pádel', date: '05 Nov 2026', spots: '32 jugadores' }
    ];
    document.getElementById('eventsList').innerHTML = events.map(function(e) {
      return '<div class="event"><div class="event-row"><div class="event-info"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg><div><h3>'+e.title+'</h3><p class="date">'+e.date+' · '+e.spots+'</p></div></div><a class="btn btn-outline" href="#" style="padding:10px 20px;">Inscribirse</a></div></div>';
    }).join('');

    // Blog
    var posts = [
      { title: '5 consejos para mejorar tu saque en tenis', excerpt: 'Técnicas prácticas que te ayudarán a ganar potencia y precisión.', date: '02 Oct 2026', category: 'Tenis', img: 'https://images.unsplash.com/photo-1622279457486-62dcc4a431d6?auto=format&fit=crop&q=80&w=1200' },
      { title: 'Cómo elegir la cancha de fútbol ideal', excerpt: 'Superficies, tamaño y ubicación: lo que debes considerar.', date: '28 Sep 2026', category: 'Fútbol', img: 'https://images.unsplash.com/photo-1579952363873-27f5b4cf2153?auto=format&fit=crop&q=80&w=1200' },
      { title: 'Pádel: el deporte que crece en Panamá', excerpt: 'Por qué cada vez más personas se suman al pádel.', date: '20 Sep 2026', category: 'Pádel', img: 'https://images.unsplash.com/photo-1606107837371-4bc24e703649?auto=format&fit=crop&q=80&w=1200' },
      { title: 'Entrenamiento funcional para deportistas', excerpt: 'Rutinas para mejorar tu rendimiento en cualquier deporte.', date: '15 Sep 2026', category: 'Fitness', img: 'https://images.unsplash.com/photo-1517836357463-d4af1c12875e?auto=format&fit=crop&q=80&w=1200' }
    ];
    document.getElementById('blogGrid').innerHTML = posts.map(function(p) {
      return '<article class="card blog-card"><div class="card-img" style="aspect-ratio:16/9;"><img src="'+p.img+'" alt="'+p.title+'"></div><div class="card-body"><div class="blog-meta"><span class="cat">'+p.category+'</span><span>📅 '+p.date+'</span></div><h2>'+p.title+'</h2><p class="muted">'+p.excerpt+'</p><span class="read-more">Leer más →</span></div></article>';
    }).join('');

    // Contact form
    function submitForm(e) {
      e.preventDefault();
      document.getElementById('contactFormWrap').innerHTML = '<div class="sent-box"><svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#00E5FF" stroke-width="2" style="margin:0 auto;"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg><h3>¡Mensaje enviado!</h3><p class="muted">Nos pondremos en contacto pronto.</p></div>';
    }
  </script>
</body>
</html>
